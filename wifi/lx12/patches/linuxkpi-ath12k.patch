+/* (wifi/lx12) the first Element ID Extension element (255) with that extension id */
+static inline const struct element *
+cfg80211_find_ext_elem(uint8_t ext, const uint8_t *data, size_t len)
+{
+	size_t at = 0;
+
+	while (at + 2 <= len && at + 2 + data[at + 1] <= len) {
+		if (data[at] == 255 && data[at + 1] >= 1 && data[at + 2] == ext)
+			return ((const struct element *)(data + at));
+		at += 2 + data[at + 1];
+	}
+	return (NULL);
+}
