+/*
+ * 802.11be-2024 (wifi/lx12, for ath12k): what the EML Capabilities subfield of a multi-link
+ * element encodes, in microseconds (Tables 9-417i, 9-417j, 9-417m); 0 for what is reserved.
+ * The fields are taken by their bits here: the IEEE80211_EML_CAP_* masks above are placeholders.
+ */
+static inline uint32_t
+ieee80211_emlsr_pad_delay_in_us(uint16_t eml_cap)
+{
+	uint32_t code = (eml_cap >> 1) & 0x7;		/* B1-B3: EMLSR Padding Delay */
+
+	return (code == 0 || code > 4 ? 0 : 32u << (code - 1));
+}
+
+static inline uint32_t
+ieee80211_emlsr_trans_delay_in_us(uint16_t eml_cap)
+{
+	uint32_t code = (eml_cap >> 4) & 0x7;		/* B4-B6: EMLSR Transition Delay */
+
+	return (code == 0 || code > 5 ? 0 : 16u << (code - 1));
+}
+
+static inline uint32_t
+ieee80211_eml_trans_timeout_in_us(uint16_t eml_cap)
+{
+	uint32_t code = (eml_cap >> 11) & 0xf;		/* B11-B14: Transition Timeout */
+
+	return (code == 0 || code > 11 ? 0 : 128u << (code - 1));
+}
+
+#define	IEEE80211_EHT_OPER_MCS15_DISABLE		0x40	/* 802.11be-2024, 9.4.2.322, EHT Operation Parameters B6 */
+
 #endif	/* _LINUXKPI_LINUX_IEEE80211_H */
diff -ruN a/sys/compat/linuxkpi/common/include/linux/list.h b/sys/compat/linuxkpi/common/include/linux/list.h
--- a/sys/compat/linuxkpi/common/include/linux/list.h	2026-11-01 09:49:01.066219117 +0000
+++ b/sys/compat/linuxkpi/common/include/linux/list.h	2026-11-01 09:52:01.073040181 +0000
@@ -461,6 +461,22 @@
 		__list_cut_position(list, head, entry);
 }
 
+/* (wifi/lx12) everything of head before entry onto list (which is made anew), entry staying in head */
+static inline void list_cut_before(struct list_head *list,
+		struct list_head *head, struct list_head *entry)
+{
+	if (head->next == entry) {
+		INIT_LIST_HEAD(list);
+		return;
+	}
+	list->next = head->next;
+	list->next->prev = list;
+	list->prev = entry->prev;
+	list->prev->next = list;
+	head->next = entry;
+	entry->prev = head;
+}
