@@ -1172,4 +1172,24 @@
 #define	SKB_WITH_OVERHEAD(_s)						\
 	(_s) - ALIGN(sizeof(struct skb_shared_info), CACHE_LINE_SIZE)
 
+/*
+ * (wifi/lx12, for ath12k's dp_tx.c) room for tailbits more at the end of the data: the buffers
+ * here are linear, so it is there or it is not; the buffer that has the end is the buffer itself.
+ */
+static inline int
+skb_cow_data(struct sk_buff *skb, int tailbits, struct sk_buff **trailer)
+{
+	if (skb_tailroom(skb) < tailbits)
+		return (-ENOMEM);
+	*trailer = skb;
+	return (1);
+}
+
+static inline void *
+pskb_put(struct sk_buff *skb, struct sk_buff *tail, int len)
+{
+	(void)skb;
+	return (skb_put(tail, len));
+}
+
 #endif	/* _LINUXKPI_LINUX_SKBUFF_H */
